+    if (!source || !value || size != sizeof(VDInputMetadataV1)) return 0;
+    std::lock_guard<std::mutex> guard(inputMetadataMutex);
+    const VDInputMetadataV1* found = nullptr;
+    for (const auto& item : inputMetadata) {
+        if (_wcsicmp(item.second.source.c_str(), source)) continue;
+        const auto& m = item.second.value;
+        if (found && (found->fps_num != m.fps_num || found->fps_den != m.fps_den ||
+            found->width != m.width || found->height != m.height ||
+            wcscmp(found->resolved_path, m.resolved_path))) return 0;
+        found = &m;
+    }
+    if (!found) return 0;
+    *value = *found;
+    return 1;
+}
