+    file->video_source->GetVideoSourceInfo(video);
+    p.value.width = video.mWidth; p.value.height = video.mHeight;
+    const char* codec = "Video";
+    if (file->playlist && !file->playlist->items.empty())
+        codec = file->playlist->items.front().codec == 0x24 ? "HEVC" : "AVC";
+    else if (file->video_source->m_pCodecCtx)
+        codec = avcodec_get_name(file->video_source->m_pCodecCtx->codec_id);
+    strncpy_s(p.value.codec, codec, _TRUNCATE);
+    const auto& resolved = file->playlist ? file->playlist->path : file->m_path;
+    wcsncpy_s(p.value.resolved_path, resolved.c_str(), _TRUNCATE);
+    // Publish values only after initialization. Readers never touch the decoder.
+    std::lock_guard<std::mutex> guard(inputMetadataMutex);
+    inputMetadata[file] = std::move(p);
+}
+}
+extern "C" __declspec(dllexport) int __cdecl VDReadInputMetadata(
