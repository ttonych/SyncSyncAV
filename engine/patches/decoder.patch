+// SPDX-License-Identifier: BSD-3-Clause
+#include "stdafx.h"
+#include "IsoDisc.h"
+#include "Utils/StringUtil.h"
+#include <objbase.h>
+#pragma comment(lib,"ole32.lib")
+extern "C" {
+#include <libavformat/avformat.h>
+}
+#include <algorithm>
+#include <stdexcept>
+
+extern HINSTANCE hInstance;
+namespace fs = std::filesystem;
+namespace {
+struct UdfApi {
+    HMODULE module = nullptr;
+    decltype(&udfread_init) init;
+    decltype(&udfread_open) openVolume;
+    decltype(&udfread_close) close;
+    decltype(&udfread_opendir) openDir;
+    decltype(&udfread_readdir) readDir;
+    decltype(&udfread_closedir) closeDir;
+    decltype(&udfread_file_open) openFile;
+    decltype(&udfread_file_close) closeFile;
+    decltype(&udfread_file_read) read;
+    decltype(&udfread_file_seek) seek;
+    decltype(&udfread_file_size) size;
+
+    template<class F> void load(F& function, const char* name) {
+        function = reinterpret_cast<F>(GetProcAddress(module, name));
+        if (!function) throw std::runtime_error("Incomplete libudfread API");
+    }
+    UdfApi() {
+        wchar_t exe[32768];
+        DWORD n = GetModuleFileNameW(hInstance, exe, DWORD(std::size(exe)));
+        if (!n || n >= std::size(exe)) throw std::runtime_error("Cannot locate ISO reader");
+        auto dll = fs::path(exe).parent_path() / L"libbluray" / L"udfread-3.dll";
+        module = LoadLibraryExW(dll.c_str(), nullptr, LOAD_LIBRARY_SEARCH_DLL_LOAD_DIR | LOAD_LIBRARY_SEARCH_DEFAULT_DIRS);
+        if (!module) throw std::runtime_error("Cannot load bundled libudfread");
+        try {
+            load(init,"udfread_init"); load(openVolume,"udfread_open"); load(close,"udfread_close");
+            load(openDir,"udfread_opendir"); load(readDir,"udfread_readdir"); load(closeDir,"udfread_closedir");
+            load(openFile,"udfread_file_open"); load(closeFile,"udfread_file_close");
+            load(read,"udfread_file_read"); load(seek,"udfread_file_seek"); load(size,"udfread_file_size");
+        } catch (...) { FreeLibrary(module); throw; }
+    }
+    ~UdfApi() { FreeLibrary(module); }
+};
+UdfApi& api() { static UdfApi instance; return instance; }
+
+template<class Visitor>
+void visit(udfread* disc, const std::string& path, Visitor visitor) {
+    std::unique_ptr<UDFDIR, decltype(&udfread_closedir)> dir(api().openDir(disc,path.c_str()),api().closeDir);
+    if (!dir) return;
+    udfread_dirent entry{};
+    while (api().readDir(dir.get(), &entry)) visitor(entry);
+}
+}
+
+IsoDisc::IsoDisc(const fs::path& source) : path(source), volume(api().init(),api().close) {
+    if (!volume || api().openVolume(volume.get(),ConvertWideToUtf8(path.wstring()).c_str()) < 0)
+        throw std::runtime_error("Cannot open UDF disc image");
+    // All names used by Blu-ray are ASCII. Retain original spelling for UDF,
+    // which can be case-sensitive, and expose canonical paths to the decoder.
+    std::string bdmv;
+    visit(volume.get(), "/", [&](const udfread_dirent& entry) {
+        if (entry.d_type == UDF_DT_DIR && !_stricmp(entry.d_name,"BDMV")) bdmv = entry.d_name;
+    });
+    if (bdmv.empty()) return;
+    visit(volume.get(), bdmv, [&](const udfread_dirent& dir) {
+        if (dir.d_type != UDF_DT_DIR) return;
+        const char* ext = nullptr;
+        const wchar_t* directory = nullptr;
+        if (!_stricmp(dir.d_name,"PLAYLIST")) { directory=L"PLAYLIST"; ext=".mpls"; }
+        else if (!_stricmp(dir.d_name,"STREAM")) { directory=L"STREAM"; ext=".m2ts"; }
+        else if (!_stricmp(dir.d_name,"CLIPINF")) { directory=L"CLIPINF"; ext=".clpi"; }
+        else return;
+        auto udfDir = bdmv + "/" + dir.d_name;
+        visit(volume.get(), udfDir, [&](const udfread_dirent& file) {
+            if (file.d_type != UDF_DT_REG) return;
+            std::string name(file.d_name);
+            if (name.size()!=5+strlen(ext) || name.find_first_not_of("0123456789")!=5 || _stricmp(name.c_str()+5,ext)) return;
+            auto key = fs::path(L"BDMV") / directory / (name.substr(0,5)+ext);
+            if (members.emplace(key.wstring(),udfDir+"/"+name).second && !strcmp(ext,".mpls"))
+                playlists.push_back(path / key);
+        });
+    });
+}
+IsoFile IsoDisc::open(const fs::path& member) const {
+    auto found = members.find(member.lexically_relative(path).wstring());
+    return IsoFile(found == members.end() ? nullptr : api().openFile(volume.get(),found->second.c_str()),api().closeFile);
+}
+int64_t IsoDisc::size(const fs::path& member) const {
+    auto file = open(member);
+    return file ? api().size(file.get()) : -1;
+}
+
+IsoMetadata::IsoMetadata(const IsoDisc& disc, const fs::path& member, size_t limit) {
+    auto source = disc.open(member);
+    int64_t size = source ? api().size(source.get()) : -1;
+    if (size < 1 || uint64_t(size) > limit) throw std::runtime_error("Invalid ISO metadata size");
+    std::vector<uint8_t> data(static_cast<size_t>(size));
+    if (api().read(source.get(),data.data(),data.size()) != size) throw std::runtime_error("Cannot read ISO metadata");
+    GUID id{};
+    wchar_t name[40];
+    if (FAILED(CoCreateGuid(&id)) || !StringFromGUID2(id,name,int(std::size(name))))
+        throw std::runtime_error("Cannot create metadata filename");
+    path = fs::temp_directory_path() / (std::wstring(L"SyncSyncAV-")+name+L".tmp");
+    output = CreateFileW(path.c_str(),GENERIC_WRITE,FILE_SHARE_READ,nullptr,CREATE_NEW,FILE_ATTRIBUTE_TEMPORARY,nullptr);
+    if (output == INVALID_HANDLE_VALUE) throw std::runtime_error("Cannot create temporary metadata file");
+    DWORD written=0;
+    if (!WriteFile(output,data.data(),DWORD(data.size()),&written,nullptr) || written!=data.size()) {
+        CloseHandle(output); DeleteFileW(path.c_str()); throw std::runtime_error("Cannot write temporary metadata file");
+    }
+}
+IsoMetadata::~IsoMetadata() { CloseHandle(output); DeleteFileW(path.c_str()); }
+
+IsoReader::IsoReader(std::shared_ptr<IsoDisc> image,const fs::path& clip)
+    : disc(std::move(image)),file(disc->open(clip)) {}
+IsoReader::~IsoReader() {
+    if (io) { av_freep(&io->buffer); avio_context_free(&io); }
+}
+int IsoReader::read(void* opaque,uint8_t* data,int size) {
+    auto& self = *static_cast<IsoReader*>(opaque);
+    auto n = api().read(self.file.get(),data,size);
+    return n > 0 ? int(n) : n == 0 ? AVERROR_EOF : AVERROR(EIO);
+}
+int64_t IsoReader::seek(void* opaque,int64_t offset,int whence) {
+    auto& self = *static_cast<IsoReader*>(opaque);
+    whence &= ~AVSEEK_FORCE;
+    if (whence == AVSEEK_SIZE) return api().size(self.file.get());
+    if (whence != SEEK_SET && whence != SEEK_CUR && whence != SEEK_END) return AVERROR(EINVAL);
+    auto pos = api().seek(self.file.get(),offset,whence);
+    return pos < 0 ? AVERROR(EIO) : pos;
+}
+int IsoReader::openFormat(AVFormatContext** format) {
+    if (!file) return AVERROR(ENOENT);
+    constexpr int bytes = 64*1024;
+    auto buffer = static_cast<uint8_t*>(av_malloc(bytes));
+    if (!buffer) return AVERROR(ENOMEM);
+    io = avio_alloc_context(buffer,bytes,0,this,read,nullptr,seek);
+    if (!io) { av_free(buffer); return AVERROR(ENOMEM); }
+    *format = avformat_alloc_context();
+    if (!*format) return AVERROR(ENOMEM);
+    (*format)->pb = io;
+    (*format)->flags |= AVFMT_FLAG_CUSTOM_IO;
+    return avformat_open_input(format,nullptr,av_find_input_format("mpegts"),nullptr);
+}
+
