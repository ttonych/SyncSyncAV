+   SetDlgItemTextW(h,2203,L"Сравните длительность и порядок клипов. Повторы могут обозначать меню или зацикленный фрагмент.");
+   SetDlgItemTextW(h,2204,L"Откройте .mpls для одного плейлиста или ISO для выбора из списка.");
+   SetDlgItemTextW(h,IDOK,L"Открыть");
+   SetDlgItemTextW(h,IDCANCEL,L"Отмена");
+  }
+  const wchar_t* enTitles[]={L"Playlist",L"Duration",L"Parts",L"Clips (M2TS)",L"Video",L"Notes"};
+  const wchar_t* ruTitles[]={L"Плейлист",L"Длительность",L"Части",L"Клипы (M2TS)",L"Видео",L"Примечания"};
+  const auto titles=ru?ruTitles:enTitles;
+  int widths[]={90,112,45,180,165,215};
+  for(int c=0;c<6;c++){LVCOLUMNW col{};col.mask=LVCF_TEXT|LVCF_WIDTH;col.pszText=(wchar_t*)titles[c];col.cx=widths[c];ListView_InsertColumn(list,c,&col);}
+  int suggested=-1;
+  for(int k=0;k<(int)d->rows.size();k++) {
+   const auto& p=*d->rows[k];
+   if(suggested<0 && !p.repeated && p.error.empty())suggested=k;
+   std::wstring note=p.error.empty()?(p.repeated?(ru?std::format(L"Повторов: {}",p.repeated):std::format(L"{} repeated ranges",p.repeated)):L""):(ru?L"Не поддерживается":L"Unsupported");
+   if(k==suggested) note=ru?L"Самый длинный без повторов":L"Longest without repeats";
+   std::wstring clips;for(size_t j=0;j<std::min<size_t>(3,p.items.size());j++){if(j)clips+=L", ";clips+=p.items[j].clip;}if(p.items.size()>3)clips+=L", ...";
+   std::wstring fields[]={p.name,duration(p.duration45),std::to_wstring(p.items.size()),clips,videoText(p),note};
+   LVITEMW it{};it.mask=LVIF_TEXT;it.iItem=k;it.pszText=fields[0].data();ListView_InsertItem(list,&it);
+   for(int c=1;c<6;c++)ListView_SetItemText(list,k,c,fields[c].data());
+  }
+  if(!d->current.empty()) {
+   for(size_t k=0;k<d->rows.size();++k)if(!_wcsicmp(d->rows[k]->path.c_str(),d->current.c_str())){suggested=int(k);break;}
+  }
+  if(suggested<0 && !d->rows.empty())suggested=0;
+  if(suggested>=0){ListView_SetItemState(list,suggested,LVIS_SELECTED|LVIS_FOCUSED,LVIS_SELECTED|LVIS_FOCUSED);ListView_EnsureVisible(list,suggested,FALSE);}
+  details(h,d);SetFocus(list);return FALSE;
+ }
+ if(!d)return FALSE;
+ if(msg==WM_NOTIFY) {
+  auto n=(NMHDR*)l;if(n->idFrom==2201){if(n->code==LVN_ITEMCHANGED)details(h,d);if(n->code==NM_DBLCLK)SendMessageW(h,WM_COMMAND,IDOK,0);}return FALSE;
+ }
+ if(msg==WM_COMMAND && LOWORD(w)==IDOK) {
+  int n=ListView_GetNextItem(GetDlgItem(h,2201),-1,LVNI_SELECTED);if(n>=0&&d->rows[n]->error.empty()){d->chosen=n;EndDialog(h,IDOK);}return TRUE;
+ }
+ if((msg==WM_COMMAND&&LOWORD(w)==IDCANCEL)||msg==WM_CLOSE){EndDialog(h,IDCANCEL);return TRUE;}return FALSE;
+}
+int streamPid(AVFormatContext* f,int pid,AVMediaType type) {
+ for(unsigned k=0;k<f->nb_streams;k++) if(f->streams[k]->id==pid && f->streams[k]->codecpar->codec_type==type)return int(k);
+ return -1;
+}
+class MplsVideo final:public VDFFVideoSource {
+ const VDXInputDriverContext& ctx;
+ std::shared_ptr<MplsPlaylist> pl;
+ struct Slot {VDFFInputFile* file=nullptr;std::wstring clip;int pid=-1;uint64_t age=0;};
+ std::array<Slot,2> slots{};uint64_t clock=0;
+ VDFFVideoSource* active=nullptr;int64_t local=-1,last=-1,desired=-1;int required=0;
+ int target=0;bool dib=false;uint32 mode=kStreamModeUncompress;
+ VDXVideoSourceInfo vi{};VDXPixmap empty{};FilterModPixmapInfo pi{};
+ AVPixelFormat pixelFormat=AV_PIX_FMT_NONE;
+ bool select(int64_t n) {
+  if(n<0 || n>=pl->frames)return false;
+  auto it=std::upper_bound(pl->items.begin(),pl->items.end(),n,[](int64_t a,const MplsItem& b){return a<b.first;});--it;
+  Slot* slot=nullptr;for(auto& s:slots)if(s.file&&s.age&&s.clip==it->clip&&s.pid==it->pid)slot=&s;
+  if(!slot) {
+   slot=&*std::min_element(slots.begin(),slots.end(),[](auto&a,auto&b){return a.age<b.age;});
+   if(slot->file){if(active==slot->file->video_source)active=nullptr;slot->file->Release();*slot={};}
+   auto f=new VDFFInputFile(ctx);f->AddRef();slot->file=f;slot->clip=it->clip;slot->pid=it->pid;
+   for(const auto& i:pl->items)if(i.clip==it->clip)f->mpls_out45=std::max(f->mpls_out45,i.out45);
+   f->image=pl->image;
+   f->mpls_cache_bytes=256ull*1024*1024;
+   auto path=(fs::path(pl->bdmv)/L"STREAM"/(it->clip+L".m2ts")).wstring();f->Init(path.c_str(),nullptr);
+   if(!f->m_pFormatCtx)return false;
+   int idx=streamPid(f->m_pFormatCtx,it->pid,AVMEDIA_TYPE_VIDEO);
+   if(idx<0){ctx.mpCallbacks->SetError("MPLS: primary video PID is missing.");return false;}
+   f->mpls_seek_points=ReadMplsClpi(pl->bdmv,*it,pl->image);
+   auto v=new VDFFVideoSource(ctx);v->AddRef();f->video_source=v;
+   if(v->initStream(f,idx)<0)return false;
+   VDXVideoSourceInfo actual{};v->GetVideoSourceInfo(actual);
+   const auto& rate=v->m_streamInfo.mInfo.mSampleRate;
+   if(int64_t(rate.mNumerator)*pl->fpsDen!=int64_t(pl->fpsNum)*rate.mDenominator ||
+    (vi.mWidth&&(vi.mWidth!=actual.mWidth||vi.mHeight!=actual.mHeight||pixelFormat!=v->m_pCodecCtx->pix_fmt)) ||
+    v->m_pCodecCtx->field_order>AV_FIELD_PROGRESSIVE ||
+    v->m_pCodecCtx->codec_id!=(it->codec==0x24?AV_CODEC_ID_HEVC:AV_CODEC_ID_H264)) {
+    ctx.mpCallbacks->SetError("MPLS: actual clip format differs from playlist.");return false;
+   }
+   if(!vi.mWidth) {vi=actual;pixelFormat=v->m_pCodecCtx->pix_fmt;m_streamInfo=v->m_streamInfo;m_streamInfo.mInfo.mSampleCount=pl->frames;}
+   v->ApplyStreamMode(mode);if(!v->SetTargetFormat(target,dib))return false;
+  }
+  slot->age=++clock;active=slot->file->video_source;
+  if(!active)return false;
+  int64_t inpts=av_rescale_q(it->in45,AVRational{1,45000},active->m_pStream->time_base);
+  int64_t offset=av_rescale_q(inpts-active->m_start_time,active->m_pStream->time_base,AVRational{pl->fpsDen,pl->fpsNum});
+  local=offset+n-it->first;
+  if(local<0 || local>=active->m_sample_count){ctx.mpCallbacks->SetError("MPLS: requested frame is outside the clip.");return false;}
+  return true;
+ }
+public:
+ MplsVideo(const VDXInputDriverContext& c,std::shared_ptr<MplsPlaylist> p):VDFFVideoSource(c),ctx(c),pl(std::move(p)){}
+ ~MplsVideo(){for(auto& s:slots)if(s.file)s.file->Release();}
+ bool init(){return select(0);}
+ void VDXAPIENTRY GetVideoSourceInfo(VDXVideoSourceInfo& i)override{i=vi;}
+ bool VDXAPIENTRY Read(sint64 n,uint32 count,void* b,uint32 size,uint32* bytes,uint32* samples)override {
+  *bytes=0;*samples=0;if(!count||n==pl->frames)return true;if(b&&!size)return false;if(!select(n))return false;
+  bool ok=active->Read(local,1,b,size,bytes,samples);if(ok&&b)required=0;return ok;
+ }
+ const void* VDXAPIENTRY DecodeFrame(const void* b,uint32 size,bool pre,sint64 sample,sint64 frame)override {
+  if(!select(frame))return nullptr;auto result=active->DecodeFrame(b,size,pre,local,local);if(result)last=frame;return result;
+ }
+ const VDXPixmap& VDXAPIENTRY GetFrameBuffer()override{return active?active->GetFrameBuffer():empty;}
+ const FilterModPixmapInfo& VDXAPIENTRY GetFrameBufferInfo()override {if(active)pi=active->GetFrameBufferInfo();pi.frame_num=last;return pi;}
+ const void* VDXAPIENTRY GetFrameBufferBase()override{return active?active->GetFrameBufferBase():nullptr;}
+ bool VDXAPIENTRY IsFrameBufferValid()override{return last>=0&&active&&active->IsFrameBufferValid();}
+ bool VDXAPIENTRY SetTargetFormat(int f,bool d)override {target=f;dib=d;for(auto& s:slots)if(s.file&&s.file->video_source&&!s.file->video_source->SetTargetFormat(f,d))return false;last=-1;return true;}
+ bool VDXAPIENTRY SetDecompressedFormat(const VDXBITMAPINFOHEADER*)override{return false;}
+ void VDXAPIENTRY ApplyStreamMode(uint32 f)override{mode=(f&kStreamModePlayForward)|kStreamModeUncompress;for(auto&s:slots)if(s.file&&s.file->video_source)s.file->video_source->ApplyStreamMode(mode);}
+ bool VDXAPIENTRY QueryStreamMode(uint32 f)override{return !(f&kStreamModeDirectCopy);}
+ const void* VDXAPIENTRY GetDirectFormat()override{return nullptr;}
+ int VDXAPIENTRY GetDirectFormatLen()override{return 0;}
+ void VDXAPIENTRY GetSampleInfo(sint64,VDXVideoFrameInfo& i)override{i.mBytePosition=-1;i.mFrameType=kVDXVFT_Independent;i.mTypeChar='K';}
+ bool VDXAPIENTRY IsKey(sint64 n)override{return n>=0&&n<pl->frames;}
+ bool VDXAPIENTRY IsDecodable(sint64 n)override{return n>=0&&n<pl->frames;}
+ void VDXAPIENTRY SetDesiredFrame(sint64 n)override{desired=n;required=1;}
+ sint64 VDXAPIENTRY GetNextRequiredSample(bool& pre)override{pre=false;return required?desired:-1;}
+ int VDXAPIENTRY GetRequiredCount()override{return required;}
+ void VDXAPIENTRY Reset()override{required=0;last=-1;}
+};
+class MplsAudio final:public VDFFAudioSource {
+ const VDXInputDriverContext& ctx;std::shared_ptr<MplsPlaylist> pl;int index;
+ VDFFInputFile* file=nullptr;VDFFAudioSource* audio=nullptr;int current=-1;
+ std::vector<int64_t> bounds;std::vector<unsigned char> target;WAVEFORMATEXTENSIBLE format{};
+ bool select(int k) {
+  if(current==k&&audio)return true;
+  if(file){file->Release();file=nullptr;audio=nullptr;}current=-1;
+  const auto&i=pl->items[k];if(index>=int(i.audioPids.size())){ctx.mpCallbacks->SetError("MPLS: audio track is absent from a clip.");return false;}
+  file=new VDFFInputFile(ctx);file->AddRef();file->image=pl->image;
+  auto path=(fs::path(pl->bdmv)/L"STREAM"/(i.clip+L".m2ts")).wstring();file->Init(path.c_str(),nullptr);
+  if(!file->m_pFormatCtx)return false;
+  int ai=streamPid(file->m_pFormatCtx,i.audioPids[index],AVMEDIA_TYPE_AUDIO);
+  int vi=streamPid(file->m_pFormatCtx,i.pid,AVMEDIA_TYPE_VIDEO);
+  if(ai<0||vi<0){ctx.mpCallbacks->SetError("MPLS: audio/video PID is missing.");return false;}
+  file->video_start_time=av_rescale_q(i.in45,AVRational{1,45000},file->m_pFormatCtx->streams[vi]->time_base);
+  file->mpls_out45=i.out45;
+  audio=new VDFFAudioSource(ctx);audio->AddRef();file->audio_source=audio;
+  if(audio->initStream(file,ai)<0)return false;
+  audio->SetTargetFormat(target.empty()?nullptr:(const VDXWAVEFORMATEX*)target.data());
+  WAVEFORMATEXTENSIBLE actual{};memcpy(&actual,audio->GetDirectFormat(),sizeof(actual));
+  if(format.Format.nSamplesPerSec&&memcmp(&format,&actual,sizeof(actual))){ctx.mpCallbacks->SetError("MPLS: audio formats differ between clips.");return false;}
+  format=actual;current=k;return true;
+ }
+public:
+ MplsAudio(const VDXInputDriverContext& c,std::shared_ptr<MplsPlaylist> p,int n):VDFFAudioSource(c),ctx(c),pl(std::move(p)),index(n){}
+ ~MplsAudio(){if(file)file->Release();}
+ bool init(){
+  if(!select(0))return false;int64_t ticks=0;bounds.push_back(0);
+  for(const auto&i:pl->items){ticks+=int64_t(i.out45)-i.in45;bounds.push_back(av_rescale_q(ticks,AVRational{1,45000},AVRational{1,int(format.Format.nSamplesPerSec)}));}
+  audio->GetStreamSourceInfo(m_streamInfo);m_streamInfo.mSampleCount=bounds.back();return true;
+ }
+ const void* VDXAPIENTRY GetDirectFormat()override{return &format;}
+ int VDXAPIENTRY GetDirectFormatLen()override{return sizeof(format);}
+ void VDXAPIENTRY SetTargetFormat(const VDXWAVEFORMATEX* f)override {
+  target.clear();if(f){auto w=(const WAVEFORMATEX*)f;size_t n=sizeof(WAVEFORMATEX)+w->cbSize;if(n>4096)return;target.assign((const unsigned char*)f,(const unsigned char*)f+n);}
+  if(audio){audio->SetTargetFormat(f);memcpy(&format,audio->GetDirectFormat(),sizeof(format));}
+ }
+ bool VDXAPIENTRY Read(int64_t n,uint32_t count,void* b,uint32_t size,uint32_t* bytes,uint32_t* samples)override {
+  *bytes=0;*samples=0;if(n<0)return false;if(n>=bounds.back()||!count)return true;
+  count=(uint32_t)std::min<int64_t>(count,bounds.back()-n);
+  count=std::min(count,UINT_MAX/format.Format.nBlockAlign);
+  if(!b){*bytes=count*format.Format.nBlockAlign;*samples=count;return true;}
+  count=std::min(count,size/format.Format.nBlockAlign);
+  while(count){int k=int(std::upper_bound(bounds.begin(),bounds.end(),n)-bounds.begin())-1;if(!select(k))return false;
+   uint32_t want=(uint32_t)std::min<int64_t>(count,bounds[k+1]-n),nb=0,ns=0;
+   if(!audio->Read(n-bounds[k],want,(char*)b+*bytes,size-*bytes,&nb,&ns)||!ns)return false;
+   n+=ns;count-=ns;*bytes+=nb;*samples+=ns;
+  }return true;
+ }
+};
+}
+bool IsMplsPath(const wchar_t* path) {
+ auto e=fs::path(path).extension().wstring();return !_wcsicmp(e.c_str(),L".mpls")||!_wcsicmp(e.c_str(),L".bdmv")||!_wcsicmp(e.c_str(),L".iso");
+}
+std::vector<MplsSeekPoint> ReadMplsClpi(const std::wstring& bdmv,const MplsItem& item,const std::shared_ptr<IsoDisc>& image) {
+ // CLPI is optional acceleration, never the source of decoded frame numbers.
+ // Decode the on-disc CPI table through the same pinned libbluray metadata API.
+ try {
+  const auto path=fs::path(bdmv)/L"CLIPINF"/(item.clip+L".clpi");
+  if(!image&&!fs::is_regular_file(path))return {};
+  const auto size=image?image->size(path):int64_t(fs::file_size(path));
+  if(size<40||size>16*1024*1024)return {};
+  BlurayApi api;if(!api.readClpi||!api.freeClpi)return {};
+  std::unique_ptr<IsoMetadata> metadata;
+  if(image)metadata=std::make_unique<IsoMetadata>(*image,path,16*1024*1024);
+  const auto& input=metadata?metadata->path:path;
+  std::unique_ptr<CLPI_CL,decltype(api.freeClpi)> cl(api.readClpi(ConvertWideToUtf8(input.wstring()).c_str()),api.freeClpi);
+  if(!cl||!cl->clip.num_source_packets)return {};
+  // A remuxed/truncated M2TS must not use the original disc's packet offsets.
+  auto clipPath=fs::path(bdmv)/L"STREAM"/(item.clip+L".m2ts");
+  auto bytes=image?image->size(clipPath):int64_t(fs::file_size(clipPath));
+  if(bytes!=uint64_t(cl->clip.num_source_packets)*192)return {};
+  if(item.stc!=0||cl->sequence.num_atc_seq!=1||!cl->sequence.atc_seq)return {};
+  const auto& atc=cl->sequence.atc_seq[0];
+  if(atc.offset_stc_id!=0||atc.num_stc_seq!=1||!atc.stc_seq)return {};
+  const auto& stc=atc.stc_seq[0];
+  if(!cl->cpi.entry)return {};
+  const CLPI_EP_MAP_ENTRY* map=nullptr;
+  for(unsigned k=0;k<cl->cpi.num_stream_pid;k++)if(cl->cpi.entry[k].pid==item.pid)map=&cl->cpi.entry[k];
+  if(!map||!map->coarse||!map->fine||map->num_ep_fine<=0||map->num_ep_fine>500000||
+     map->num_ep_coarse<=0||map->num_ep_coarse>map->num_ep_fine||map->coarse[0].ref_ep_fine_id!=0)return {};
+  std::vector<MplsSeekPoint> points;points.reserve(map->num_ep_fine);
+  for(int k=0;k<map->num_ep_coarse;k++) {
+   const auto& coarse=map->coarse[k];int first=coarse.ref_ep_fine_id;
+   int end=k+1<map->num_ep_coarse?map->coarse[k+1].ref_ep_fine_id:map->num_ep_fine;
+   if(first<0||end<=first||end>map->num_ep_fine||coarse.pts_ep<0||coarse.pts_ep>0x3fff)return {};
+   for(int j=first;j<end;j++) {
+    const auto& fine=map->fine[j];
+    if(fine.pts_ep<0||fine.pts_ep>0x7ff||fine.spn_ep<0||fine.spn_ep>0x1ffff)return {};
+    uint64_t pts=(uint64_t(coarse.pts_ep&~1)<<18)+(uint64_t(fine.pts_ep)<<8);
+    uint64_t packet=uint64_t(coarse.spn_ep&~0x1ffffu)+fine.spn_ep;
+    if(pts>UINT32_MAX||packet>=cl->clip.num_source_packets)return {};
+    if(packet<stc.spn_stc_start)continue;
+    if(!points.empty()&&(pts<points.back().pts45||packet<=points.back().packet))return {};
+    points.push_back({uint32_t(pts),uint32_t(packet)});
+   }
+  }
+  if(GetEnvironmentVariableA("VD_CLPI_TRACE",nullptr,0))fprintf(stderr,"CLPI %ls: %zu entry points, %llu bytes metadata\n",item.clip.c_str(),points.size(),size);
+  return points;
+ }catch(const std::exception&){return {};}
+}
+std::wstring MplsPlaylist::description() const {
+ const bool ru=russianUi();
+ std::wostringstream s;s<<path<<(ru?L"\r\nДлительность: ":L"\r\nDuration: ")<<duration(duration45)<<(ru?L"   Кадров: ":L"   Frames: ")<<frames<<L"   "<<videoText(*this)<<L"\r\n";
+ if(!error.empty())s<<(ru?L"Не поддерживается: ":L"Unsupported: ")<<error<<L"\r\n";
+ s<<(ru?L"Языки аудио: ":L"Audio languages: ")<<(items.empty()?L"":items[0].languages)<<L"\r\n";
+ s<<(ru?L"Основное видео, ракурс 1. Команды меню и паузы пропускаются.\r\n":L"Primary video / angle 1. Menu commands and still pauses are not played.\r\n");
+ if(repeated)s<<(ru?L"Повторяющихся диапазонов: ":L"Repeated clip ranges: ")<<repeated<<(ru?L". Большая длительность может быть результатом зацикливания.\r\n":L". Long duration may be a loop, not a film.\r\n");
+ int n=0;for(const auto&i:items){s<<++n<<L". "<<i.clip<<L".m2ts   "<<duration(int64_t(i.out45)-i.in45)<<(ru?L"   кадры ":L"   frames ")<<i.first<<L".."<<i.first+i.count-1<<L"\r\n";}
+ return s.str();
+}
+namespace {
+std::shared_ptr<IsoDisc> openImage(const wchar_t* path) {
+ try { return std::make_shared<IsoDisc>(path); }
+ catch(const std::exception&) { throw PlaylistError("Cannot read UDF disc image",L"Не удалось прочитать образ диска UDF"); }
+}
+std::shared_ptr<MplsPlaylist> ChooseMpls(HWND owner,const wchar_t* source,const wchar_t* current) {
+ BlurayApi api;
+ const fs::path path(source);
+ Picker d;
+ if(current)d.current=current;
+ if(!_wcsicmp(path.extension().c_str(),L".iso")) {
+  auto image=openImage(source);
+  for(const auto& member:image->playlists)d.rows.push_back(parse(member,api,image));
+ } else {
+  auto folder=path.parent_path();
+  if(_wcsicmp(path.extension().c_str(),L".mpls"))folder/=L"PLAYLIST";
+  for(const auto& entry:fs::directory_iterator(folder))
+   if(entry.is_regular_file()&&!_wcsicmp(entry.path().extension().c_str(),L".mpls"))d.rows.push_back(parse(entry.path(),api));
+ }
+ if(d.rows.empty())throw PlaylistError("no MPLS files in BDMV/PLAYLIST",L"В BDMV/PLAYLIST нет файлов MPLS");
+ std::sort(d.rows.begin(),d.rows.end(),[](auto&a,auto&b){return a->duration45!=b->duration45?a->duration45>b->duration45:a->path<b->path;});
+ INITCOMMONCONTROLSEX cc{sizeof(cc),ICC_LISTVIEW_CLASSES};InitCommonControlsEx(&cc);
+ auto result=DialogBoxParamW(hInstance,MAKEINTRESOURCEW(2200),owner,pickProc,(LPARAM)&d);
+ if(result==-1)throw PlaylistError("Cannot open playlist chooser",L"Не удалось открыть список плейлистов");
+ return result==IDOK&&d.chosen>=0?d.rows[d.chosen]:nullptr;
+}
+}
+static void ValidatePlaylist(const MplsPlaylist& playlist) {
+    if (!playlist.error.empty()) throw std::runtime_error(ConvertWideToUtf8(playlist.error));
+    std::set<std::wstring> checked;
+    for (const auto& item : playlist.items) {
+        if (!checked.insert(item.clip).second) continue;
+        auto clip = fs::path(playlist.bdmv) / L"STREAM" / (item.clip + L".m2ts");
+        if (playlist.image ? playlist.image->size(clip) < 0 : !fs::is_regular_file(clip))
+            throw PlaylistError("referenced M2TS is missing", L"Отсутствует файл M2TS, указанный в плейлисте");
+    }
+}
+
+// Select before committing the new source so Cancel leaves the loaded video in place.
+static int PickInputPlaylist(HWND owner, const wchar_t* source, wchar_t* selected, uint32_t chars,
+    void* options, uint32_t capacity) {
+    try {
+        if (!source || !selected || !chars) return -2;
+        std::wstring previous;
+        if (options) {
+            if (capacity < sizeof(VDFFInputFileOptions::Data)) return -2;
+            auto current = std::make_unique<VDInputMetadataV1>();
+            if (!VDReadInputMetadata(source, current.get(), sizeof(*current)) ||
+                _wcsicmp(std::filesystem::path(current->resolved_path).extension().c_str(), L".mpls")) return -2;
+            previous = current->resolved_path;
+        }
+        auto chosen = ChooseMpls(owner, source, previous.empty() ? nullptr : previous.c_str());
+        if (!chosen || !_wcsicmp(chosen->path.c_str(), previous.c_str())) return -1;
+        if (!chosen->image) {
+            if (!options) ValidatePlaylist(*chosen);
+            if (chosen->path.size() >= chars) throw PlaylistError("Playlist path is too long", L"Слишком длинный путь к плейлисту");
+            wcscpy_s(selected, chars, chosen->path.c_str());
+            return 0;
+        }
+        if (!options) return -2;
+        VDFFInputFileOptions::Data data;
+        data.disable_cache = config_disable_cache;
+        data.iso_playlist = std::stoi(chosen->name);
+        memcpy(options, &data, sizeof(data));
+        return sizeof(data);
+    } catch (const PlaylistError& error) {
+        MessageBoxW(owner, error.display().c_str(), L"Blu-ray", MB_ICONERROR | MB_OK);
+        return -2;
+    } catch (const std::exception& error) {
+        MessageBoxW(owner, ConvertUtf8ToWide(error.what()).c_str(), L"Blu-ray", MB_ICONERROR | MB_OK);
+        return -2;
+    }
+}
+
+extern "C" __declspec(dllexport) int __cdecl VDChooseInputPlaylistW(
+    HWND owner, wchar_t* source, uint32_t chars, void* options, uint32_t capacity) {
+    if (!options) return -2;
+    return PickInputPlaylist(owner, source, source, chars, options, capacity);
+}
+
+extern "C" __declspec(dllexport) int __cdecl VDChooseFolderPlaylistW(
+    HWND owner, const wchar_t* index, wchar_t* selected, uint32_t chars) {
+    return PickInputPlaylist(owner, index, selected, chars, nullptr, 0);
+}
+
+std::shared_ptr<MplsPlaylist> OpenMpls(const wchar_t* path,const VDXInputDriverContext& ctx,int isoPlaylist) {
+ std::shared_ptr<MplsPlaylist> p;
+ try {
+  const fs::path source(path);
+  if(!_wcsicmp(source.extension().c_str(),L".mpls")) {
+   BlurayApi api;
+   p=parse(source,api);
+  } else if(isoPlaylist>=0 && !_wcsicmp(source.extension().c_str(),L".iso")) {
+   BlurayApi api;
+   auto image=openImage(path);
+   p=parse(source/L"BDMV"/L"PLAYLIST"/std::format(L"{:05}.mpls",isoPlaylist),api,image);
+  } else {
+   p=ChooseMpls(GetActiveWindow(),path,nullptr);
+   if(!p){ctx.mpCallbacks->SetError("%ls",russianUi()?L"Выбор плейлиста отменён.":L"MPLS selection cancelled.");return nullptr;}
+  }
+  ValidatePlaylist(*p);
+  return p;
+ }catch(const PlaylistError& e){ctx.mpCallbacks->SetError("MPLS: %ls",e.display().c_str());return nullptr;}
+ catch(const std::exception&e){ctx.mpCallbacks->SetError("MPLS: %s",e.what());return nullptr;}
+}
+VDFFVideoSource* CreateMplsVideo(const VDXInputDriverContext& c,std::shared_ptr<MplsPlaylist> p) {
+ auto v=new MplsVideo(c,std::move(p));if(!v->init()){delete v;return nullptr;}return v;
+}
+VDFFAudioSource* CreateMplsAudio(const VDXInputDriverContext& c,std::shared_ptr<MplsPlaylist> p,int n) {
+ if(n<0||n>=int(p->items[0].audioPids.size()))return nullptr;
+ auto a=new MplsAudio(c,std::move(p),n);if(!a->init()){delete a;return nullptr;}return a;
+}
