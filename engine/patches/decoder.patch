+bool VDFFVideoSource::seek_clpi_point(const int point, const int target)
+{
+	const auto& points = m_pSource->mpls_seek_points;
+	if (point < 0 || point >= int(points.size())) return false;
+	const int64_t offset = int64_t(points[point].packet) * 192;
+	avcodec_flush_buffers(m_pCodecCtx);
+	const int ret = av_seek_frame(m_pFormatCtx, -1, offset, AVSEEK_FLAG_BYTE);
