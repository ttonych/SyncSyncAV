+// Only the metadata API is used: no bd_play, HDMV interpreter or JVM.
+// Pin 1.5.0 because the diagnostic MPLS structs are version-specific.
+struct BlurayApi {
+ HMODULE module=nullptr;
+ decltype(&bd_read_mpls) read=nullptr;
+ decltype(&bd_free_mpls) free=nullptr;
+ decltype(&bd_read_clpi) readClpi=nullptr;
+ decltype(&bd_free_clpi) freeClpi=nullptr;
+ BlurayApi() {
+  wchar_t plugin[32768]{};
+  if(!GetModuleFileNameW(hInstance,plugin,(DWORD)std::size(plugin)))throw PlaylistError("cannot locate plugin",L"Не удалось определить путь к модулю");
+  auto path=fs::path(plugin).parent_path()/L"libbluray"/L"bluray-4.dll";
+  module=LoadLibraryExW(path.c_str(),nullptr,LOAD_LIBRARY_SEARCH_DLL_LOAD_DIR|LOAD_LIBRARY_SEARCH_DEFAULT_DIRS);
+  if(!module)throw PlaylistError("cannot load bundled libbluray (plugins64/libbluray)",L"Не удалось загрузить libbluray (plugins64/libbluray)");
+  auto version=(decltype(&bd_get_version))GetProcAddress(module,"bd_get_version");
+  read=(decltype(read))GetProcAddress(module,"bd_read_mpls");free=(decltype(free))GetProcAddress(module,"bd_free_mpls");
+  readClpi=(decltype(readClpi))GetProcAddress(module,"bd_read_clpi");freeClpi=(decltype(freeClpi))GetProcAddress(module,"bd_free_clpi");
+  int a=0,b=0,c=0;if(version)version(&a,&b,&c);
+  if(a!=1||b!=5||c!=0||!read||!free){FreeLibrary(module);module=nullptr;throw PlaylistError("libbluray 1.5.0 metadata API is required",L"Требуется libbluray 1.5.0 с поддержкой чтения метаданных");}
+ }
+ ~BlurayApi(){if(module)FreeLibrary(module);}
+};
+std::wstring duration(int64_t ticks) {
+ auto ms=(ticks*1000+22500)/45000;auto s=ms/1000;
+ return std::format(L"{:02}:{:02}:{:02}.{:03}",s/3600,s/60%60,s%60,ms%1000);
+}
+std::wstring videoText(const MplsPlaylist& p) {
+ if(p.items.empty()) return L"";
+ const auto& i=p.items[0];
+ return std::format(L"{} {} / {:.3f}",i.codec==0x24?L"HEVC":i.codec==0x1b?L"AVC":L"Other",
+  i.format==8?L"2160p":i.format==6?L"1080p":L"other",p.fpsDen?double(p.fpsNum)/p.fpsDen:0.0);
+}
+std::shared_ptr<MplsPlaylist> parse(const fs::path& path,BlurayApi& api,const std::shared_ptr<IsoDisc>& image = {}) {
+ auto p=std::make_shared<MplsPlaylist>();p->image=image;p->path=path.wstring();p->name=path.filename().wstring();p->bdmv=path.parent_path().parent_path().wstring();
+ try {
+  auto n=image?image->size(path):int64_t(fs::file_size(path));if(n<40 || n>4*1024*1024)throw PlaylistError("invalid MPLS size",L"Недопустимый размер MPLS");
+  std::unique_ptr<IsoMetadata> metadata;
+  if(image)metadata=std::make_unique<IsoMetadata>(*image,path,4*1024*1024);
+  const auto& input=metadata?metadata->path:path;
+  std::unique_ptr<MPLS_PL,decltype(api.free)> raw(api.read(ConvertWideToUtf8(input.wstring()).c_str()),api.free);
+  if(!raw)throw PlaylistError("libbluray could not parse this MPLS",L"Не удалось прочитать MPLS через libbluray");
+  if(!raw->list_count || raw->list_count>4096 || !raw->play_item)throw PlaylistError("invalid PlayItem count",L"Недопустимое количество элементов плейлиста");
+  std::set<std::tuple<std::wstring,uint32_t,uint32_t>> ranges;
+  for(unsigned k=0;k<raw->list_count;k++) {
+   const auto& pi=raw->play_item[k];
+   if(!pi.clip || !pi.angle_count)throw PlaylistError("missing clip identifier",L"Отсутствует идентификатор клипа");
+   auto clip=std::string(pi.clip[0].clip_id,5);
+   if(clip.find_first_not_of("0123456789")!=std::string::npos || strcmp(pi.clip[0].codec_id,"M2TS"))throw PlaylistError("unsupported clip identifier",L"Неподдерживаемый идентификатор клипа");
+   MplsItem i;i.clip.assign(clip.begin(),clip.end());i.in45=pi.in_time;i.out45=pi.out_time;
+   if(i.out45<=i.in45) throw PlaylistError("invalid IN/OUT range",L"Некорректные границы клипа");
+   i.stc=pi.clip[0].stc_id;i.still=pi.still_mode;i.angle=pi.angle_count;
+   if(!pi.stn.num_video || !pi.stn.video)throw PlaylistError("playlist has no primary video",L"В плейлисте нет основного видео");
+   const auto& v=pi.stn.video[0];i.codec=v.coding_type;i.format=v.format;i.rate=v.rate;i.pid=v.stream_type==1?v.pid:-1;
+   for(unsigned j=0;j<pi.stn.num_audio;j++) {
+    const auto& a=pi.stn.audio[j];i.audioPids.push_back(a.stream_type==1?a.pid:-1);
+    if(!i.languages.empty())i.languages+=L", ";i.languages.append(a.lang,a.lang+3);
+   }
+   if(!ranges.emplace(i.clip,i.in45,i.out45).second) p->repeated++;
+   p->duration45+=int64_t(i.out45)-i.in45;p->items.push_back(std::move(i));
+  }
+  static const int nums[]={0,24000,24,25,30000,0,50,60000};
+  static const int dens[]={1,1001,1,1,1001,1,1,1001};
+  int r=p->items[0].rate;if(r<1 || r>7 || !nums[r])throw PlaylistError("unsupported frame rate",L"Неподдерживаемая частота кадров");
+  p->fpsNum=nums[r];p->fpsDen=dens[r];
+  int64_t elapsed=0;
+  for(auto& i:p->items) {
+   if(i.rate!=r || i.format!=p->items[0].format || i.codec!=p->items[0].codec)throw PlaylistError("mixed video formats are unsupported",L"В плейлисте несколько форматов видео");
+   if((i.codec!=0x1b && i.codec!=0x24) || (i.format!=6 && i.format!=8) || i.stc!=0 || i.pid<0)throw PlaylistError("this build supports progressive AVC/HEVC, primary STC only",L"Поддерживается прогрессивное AVC/HEVC с основной временной базой STC");
+   i.first=av_rescale_q(elapsed,AVRational{1,45000},AVRational{p->fpsDen,p->fpsNum});
+   elapsed+=int64_t(i.out45)-i.in45;
+   int64_t boundary=av_rescale_q(elapsed,AVRational{1,45000},AVRational{p->fpsDen,p->fpsNum});
+   i.count=boundary-i.first;if(i.count<1)throw PlaylistError("empty frame range",L"Пустой диапазон кадров");p->frames=boundary;
+  }
+ } catch(const PlaylistError& e) {p->error=e.display();}
+ catch(const std::exception& e) {std::string s=e.what();p->error.assign(s.begin(),s.end());}
+ return p;
+}
+struct Picker {std::vector<std::shared_ptr<MplsPlaylist>> rows;std::wstring current;int chosen=-1;};
+void details(HWND h,Picker* d) {
+ int n=ListView_GetNextItem(GetDlgItem(h,2201),-1,LVNI_SELECTED);
+ SetDlgItemTextW(h,2202,n>=0?d->rows[n]->description().c_str():L"");
