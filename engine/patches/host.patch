diff --git a/src/VirtualDub/source/EmbeddedTheme.h b/src/VirtualDub/source/EmbeddedTheme.h
new file mode 100644
index 0000000000000000000000000000000000000000..4dbf4866e575ac849fb5c391e6baef531b1eb5ce
--- /dev/null
+++ b/src/VirtualDub/source/EmbeddedTheme.h
@@ -0,0 +1,58 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Palette shared by the integrated host surfaces. Ordinary VirtualDub is unchanged.
+#pragma once
+#include <windows.h>
+#include <commctrl.h>
+#include <vector>
+#include <string>
+extern bool g_VDStartEmbedded;
+extern bool g_VDEmbeddedRussian;
+namespace VDEmbeddedTheme {
+    const COLORREF Canvas=RGB(15,18,21), Panel=RGB(23,26,30), Status=RGB(18,21,24);
+    const COLORREF Border=RGB(52,58,65), Ink=RGB(227,230,233), Muted=RGB(121,130,139), Accent=RGB(93,182,192);
+    inline HBRUSH CanvasBrush(){static HBRUSH b=CreateSolidBrush(Canvas);return b;}
+    inline HBRUSH PanelBrush(){static HBRUSH b=CreateSolidBrush(Panel);return b;}
+    inline HBRUSH BorderBrush(){static HBRUSH b=CreateSolidBrush(Border);return b;}
+    inline HBRUSH AccentBrush(){static HBRUSH b=CreateSolidBrush(Accent);return b;}
+    inline HBRUSH StatusBrush(){static HBRUSH b=CreateSolidBrush(Status);return b;}
+    inline HFONT Font(HWND wnd){
+        static HFONT f=NULL;
+        if(!f){HDC dc=GetDC(wnd);int dpi=GetDeviceCaps(dc,LOGPIXELSY);ReleaseDC(wnd,dc);
+            f=CreateFontW(-MulDiv(12,dpi,96),0,0,0,FW_NORMAL,FALSE,FALSE,FALSE,DEFAULT_CHARSET,OUT_DEFAULT_PRECIS,CLIP_DEFAULT_PRECIS,CLEARTYPE_QUALITY,DEFAULT_PITCH,L"Segoe UI");}
+        return f;
+    }
+    inline LRESULT CALLBACK CanvasProc(HWND wnd,UINT msg,WPARAM wp,LPARAM lp,UINT_PTR id,DWORD_PTR data){
+        if(msg==WM_NCDESTROY)RemoveWindowSubclass(wnd,CanvasProc,id);
+        if(msg==WM_ERASEBKGND){RECT r;GetClientRect(wnd,&r);FillRect((HDC)wp,&r,CanvasBrush());return 1;}
+        if(msg==WM_CTLCOLORDLG)return (LRESULT)CanvasBrush();
+        return DefSubclassProc(wnd,msg,wp,lp);
+    }
+    inline void StatusMessage(HWND wnd,UINT msg,WPARAM wp,LPARAM lp){
+        const wchar_t* key=L"SyncSyncAV.StatusText";
+        auto text=(std::wstring*)GetPropW(wnd,key);
+        if(msg==WM_NCDESTROY){RemovePropW(wnd,key);delete text;return;}
+        if((msg==SB_SETTEXTW||msg==SB_SETTEXTA)&&(wp&255)==255&&!(wp&SBT_OWNERDRAW)){
+            if(!text){text=new std::wstring;if(!SetPropW(wnd,key,text)){delete text;return;}}
+            if(!lp)text->clear();
+            else if(msg==SB_SETTEXTW)*text=(const wchar_t*)lp;
+            else {int n=MultiByteToWideChar(CP_ACP,0,(const char*)lp,-1,NULL,0);std::vector<wchar_t> b(n);if(n){MultiByteToWideChar(CP_ACP,0,(const char*)lp,-1,b.data(),n);*text=b.data();}}
+            InvalidateRect(wnd,NULL,FALSE);
+        }
+    }
+    inline LRESULT PaintStatus(HWND wnd){
+        PAINTSTRUCT ps;HDC dc=BeginPaint(wnd,&ps);RECT rc;GetClientRect(wnd,&rc);
+        FillRect(dc,&rc,StatusBrush());RECT line=rc;line.bottom=1;FillRect(dc,&line,BorderBrush());
+        HGDIOBJ old=SelectObject(dc,Font(wnd));SetBkMode(dc,TRANSPARENT);SetTextColor(dc,Muted);
+        bool simple=SendMessageW(wnd,SB_ISSIMPLE,0,0)!=0;
+        int parts=simple?1:(int)SendMessageW(wnd,SB_GETPARTS,0,0);
+        for(int i=0;i<parts;i++){
+            int part=simple?SB_SIMPLEID:i;RECT r=rc;
+            if(!simple)SendMessageW(wnd,SB_GETRECT,i,(LPARAM)&r);
+            int count=LOWORD(SendMessageW(wnd,SB_GETTEXTLENGTHW,part,0));
+            std::vector<wchar_t> text(count+1);SendMessageW(wnd,SB_GETTEXTW,part,(LPARAM)text.data());
+            auto cached=(std::wstring*)GetPropW(wnd,L"SyncSyncAV.StatusText");
+            r.left+=8;r.right-=8;DrawTextW(dc,simple&&cached?cached->c_str():text.data(),-1,&r,DT_SINGLELINE|DT_VCENTER|DT_END_ELLIPSIS|DT_NOPREFIX);
+        }
+        SelectObject(dc,old);EndPaint(wnd,&ps);return 0;
+    }
+}
diff --git a/src/VirtualDub/source/EmbeddedTransportIcons.h b/src/VirtualDub/source/EmbeddedTransportIcons.h
new file mode 100644
index 0000000000000000000000000000000000000000..a195ecbdbfd0ed0f47e3b4a9fd4d76c59ef8f1e5
--- /dev/null
+++ b/src/VirtualDub/source/EmbeddedTransportIcons.h
@@ -0,0 +1,30 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <objidl.h>
+#include <gdiplus.h>
+#pragma comment(lib,"gdiplus.lib")
+namespace VDEmbeddedTheme {
+    struct GdiPlusLifetime {ULONG_PTR token;GdiPlusLifetime(){Gdiplus::GdiplusStartupInput init;Gdiplus::GdiplusStartup(&token,&init,NULL);}~GdiPlusLifetime(){Gdiplus::GdiplusShutdown(token);}};
+    // Complete symbols have symmetric bounds. All dimensions scale with the button.
+    inline void TransportIcon(HDC dc,const RECT& rc,int symbol,COLORREF ink){
+        static GdiPlusLifetime session;
+        using namespace Gdiplus;
+        Graphics g(dc);g.SetSmoothingMode(SmoothingModeAntiAlias);g.SetPixelOffsetMode(PixelOffsetModeHalf);
+        const REAL u=(rc.bottom-rc.top)/24.0f;
+        REAL width=symbol==0?7.0f:symbol==1||symbol==2?6.0f:symbol>=3&&symbol<=8?9.0f:symbol==9||symbol==10?12.0f:5.0f;
+        REAL left=rc.left+((rc.right-rc.left)-width*u)/2,cy=(rc.top+rc.bottom)/2.0f;
+        SolidBrush brush(Color(255,GetRValue(ink),GetGValue(ink),GetBValue(ink)));
+        auto rect=[&](REAL x,REAL y,REAL ww,REAL hh){g.FillRectangle(&brush,left+x*u,cy+y*u,ww*u,hh*u);};
+        auto tri=[&](REAL x,bool right){PointF pts[3]={PointF(left+(x+(right?0:6))*u,cy-4*u),PointF(left+(x+(right?6:0))*u,cy),PointF(left+(x+(right?0:6))*u,cy+4*u)};g.FillPolygon(&brush,pts,3);};
+        if(symbol==0)rect(0,-3.5f,7,7);
+        else if(symbol==1||symbol==2){tri(0,true);}
+        else if(symbol>=3&&symbol<=8){
+            bool right=symbol==5||symbol==6||symbol==8;
+            bool barLeft=symbol==3||symbol==5||symbol==7;
+            REAL x=barLeft?3.0f:0.0f;rect(barLeft?0.0f:7.0f,-5,2,10);
+            if(symbol>=7){PointF pts[4]={PointF(left+(x+3)*u,cy-4*u),PointF(left+(x+6)*u,cy),PointF(left+(x+3)*u,cy+4*u),PointF(left+x*u,cy)};g.FillPolygon(&brush,pts,4);}
+            else tri(x,right);
+        } else if(symbol==9||symbol==10){tri(0,symbol==10);tri(6,symbol==10);}
+        else {bool right=symbol==12||symbol==14;rect(right?4.0f:0.0f,-5,1,10);rect(0,-5,5,1);rect(0,4,5,1);}
+    }
+}
diff --git a/src/VirtualDub/source/ExplorerVideoDialog.inl b/src/VirtualDub/source/ExplorerVideoDialog.inl
new file mode 100644
index 0000000000000000000000000000000000000000..f65a079bee519e30cea2c9cb6e0b828ffea588e4
--- /dev/null
+++ b/src/VirtualDub/source/ExplorerVideoDialog.inl
@@ -0,0 +1,348 @@
+﻿// Windows Explorer's file picker for the embedded A/B panes.
+namespace {
+using Microsoft::WRL::ComPtr;
+
+void VDCheckPicker(HRESULT hr) {
+	if (FAILED(hr))
+		throw MyError(g_VDEmbeddedRussian ? L"Не удалось открыть диалог выбора файла (0x%08X)." :
+			L"Unable to open the file dialog (0x%08X).", (unsigned)hr);
+}
+
+VDStringW VDShellPath(IShellItem *item) {
+	PWSTR raw = nullptr;
+	VDStringW path;
+	if (item && SUCCEEDED(item->GetDisplayName(SIGDN_FILESYSPATH, &raw))) {
+		path = raw;
+		CoTaskMemFree(raw);
+	}
+	return path;
+}
+
+constexpr DWORD kChooseFolderPlaylist = 4914;
+
+// Match the layouts accepted by the A/B drop targets, including extracted discs.
+VDStringW VDDiscFolderIndex(const VDStringW& folder) {
+	if (folder.empty()) return VDStringW();
+	auto indexIn = [](const VDStringW& bdmv) -> VDStringW {
+		VDStringW index = VDMakePath(bdmv.c_str(), L"index.bdmv");
+		DWORD attr = GetFileAttributesW(index.c_str());
+		if (attr == INVALID_FILE_ATTRIBUTES || (attr & FILE_ATTRIBUTE_DIRECTORY)) return VDStringW();
+		attr = GetFileAttributesW(VDMakePath(bdmv.c_str(), L"PLAYLIST").c_str());
+		return attr != INVALID_FILE_ATTRIBUTES && (attr & FILE_ATTRIBUTE_DIRECTORY) ? index : VDStringW();
+	};
+
+	VDStringW trimmed(folder);
+	while (!trimmed.empty() && (trimmed.back() == L'\\' || trimmed.back() == L'/'))
+		trimmed.pop_back();
+	if (!_wcsicmp(VDFileSplitPath(trimmed.c_str()), L"BDMV")) {
+		VDStringW index = indexIn(folder);
+		if (!index.empty()) return index;
+	}
+	return indexIn(VDMakePath(folder.c_str(), L"BDMV"));
+}
+
+class VDExplorerVideoEvents final : public Microsoft::WRL::RuntimeClass<
+	Microsoft::WRL::RuntimeClassFlags<Microsoft::WRL::ClassicCom>, IFileDialogEvents, IFileDialogControlEvents> {
+public:
+	explicit VDExplorerVideoEvents(VDOpenVideoDialogW32& state) : mState(state) {}
+
+	void UpdateFile(const VDStringW& path) {
+		if (mState.filename != path) {
+			mState.filename = path;
+			mState.ChangeFilename();
+		}
+	}
+
+	VDStringW ChosenDiscIndex;
+
+	VDStringW TypedName() const {
+		PWSTR raw = nullptr;
+		if (!mDialog || FAILED(mDialog->GetFileName(&raw)) || !raw) return VDStringW();
+		VDStringW typed(raw);
+		CoTaskMemFree(raw);
+		return typed;
+	}
+
+	VDStringW ResolveName(const VDStringW& name) const {
+		if (name.empty() || !VDFileIsRelativePath(name.c_str())) return name;
+		ComPtr<IShellItem> folder;
+		if (FAILED(mDialog->GetFolder(&folder))) return VDStringW();
+		VDStringW base = VDShellPath(folder.Get());
+		return base.empty() ? VDStringW() : VDMakePath(base.c_str(), name.c_str());
+	}
+
+	void UpdateDiscButton() {
+		mState.custom->SetControlState(kChooseFolderPlaylist,
+			mSelectedIndex.empty() && mCurrentIndex.empty() ? CDCS_INACTIVE : CDCS_ENABLEDVISIBLE);
+	}
+
+	bool FinishFolder(const VDStringW& index) {
+		// Leave the file picker through its normal cancel path, outside the shell
+		// notification. There is no file result until the playlist has been chosen.
+		if (index.empty() || !mState.mhdlg ||
+			!PostMessageW(mState.mhdlg, WM_COMMAND, IDCANCEL, 0)) return false;
+		ChosenDiscIndex = index;
+		return true;
+	}
+
+	// The shell sends selection notifications for list items. Typing directly into
+	// the name field also needs to refresh the decoder controls before pressing Open.
+	void UpdateTypedName() {
+		VDStringW typed = TypedName();
+		if (typed == mLastTyped) return;
+		mLastTyped = typed;
+		if (!mSelectedIndex.empty() && typed == mNameAtSelection) return;
+		typed = ResolveName(typed);
+		if (typed.empty()) return;
+		DWORD attributes = GetFileAttributesW(typed.c_str());
+		if (attributes != INVALID_FILE_ATTRIBUTES && !(attributes & FILE_ATTRIBUTE_DIRECTORY))
+			UpdateFile(typed);
+	}
+
+	static LRESULT CALLBACK WindowProc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp, UINT_PTR id, DWORD_PTR data) {
+		auto self = reinterpret_cast<VDExplorerVideoEvents *>(data);
+		if (msg == WM_COMMAND && LOWORD(wp) == IDOK) {
+			VDStringW name = self->TypedName();
+			// In Replace the shell can leave the previous video's name in the edit
+			// box after a folder is selected. An actual edit takes priority instead.
+			if (!self->mSelectedIndex.empty() && (name.empty() || name == self->mNameAtSelection) &&
+				self->FinishFolder(self->mSelectedIndex)) return 0;
+			VDStringW typed = self->ResolveName(name);
+			DWORD attr = typed.empty() ? INVALID_FILE_ATTRIBUTES : GetFileAttributesW(typed.c_str());
+			if (attr != INVALID_FILE_ATTRIBUTES && (attr & FILE_ATTRIBUTE_DIRECTORY) &&
+				self->FinishFolder(VDDiscFolderIndex(typed))) return 0;
+		}
+		if (msg == WM_TIMER && wp == id) {
+			if (self->mState.init_error) {
+				auto error = self->mState.init_error;
+				self->mState.init_error = nullptr;
+				error->post(hwnd, g_szError);
+			}
+			self->UpdateTypedName();
+			return 0;
+		}
+		if (msg == WM_NCDESTROY)
+			self->RemoveTimer();
+		return DefSubclassProc(hwnd, msg, wp, lp);
+	}
+	void RemoveTimer() {
+		if (mState.mhdlg) {
+			UINT_PTR id = reinterpret_cast<UINT_PTR>(this);
+			KillTimer(mState.mhdlg, id);
+			RemoveWindowSubclass(mState.mhdlg, WindowProc, id);
+			mState.mhdlg = nullptr;
+		}
+	}
+
+	void Attach(IFileDialog *dialog) {
+		if (mState.mhdlg) return;
+		ComPtr<IOleWindow> window;
+		if (SUCCEEDED(dialog->QueryInterface(IID_PPV_ARGS(&window))) &&
+			SUCCEEDED(window->GetWindow(&mState.mhdlg)) && mState.mhdlg) {
+			mDialog = dialog;
+			UINT_PTR id = reinterpret_cast<UINT_PTR>(this);
+			if (SetWindowSubclass(mState.mhdlg, WindowProc, id, id))
+				SetTimer(mState.mhdlg, id, 250, nullptr);
+		}
+	}
+	void Detach() {
+		RemoveTimer();
+		mState.custom = nullptr;
+		mDialog = nullptr;
+	}
+
+	IFACEMETHODIMP OnFolderChanging(IFileDialog *, IShellItem *target) override {
+		// The initial and sidebar locations are navigation. Activating a selected
+		// item in the file list (including double-click/Enter) opens a disc.
+		mActivatedFolder.clear();
+		if (!mSelectedIndex.empty()) {
+			VDStringW path = VDShellPath(target);
+			if (VDFileIsPathEqual(path.c_str(), mSelectedFolder.c_str()))
+				mActivatedFolder = path;
+		}
+		return S_OK;
+	}
+	IFACEMETHODIMP OnFolderChange(IFileDialog *dialog) override {
+		Attach(dialog);
+		mLastTyped.clear();
+		ComPtr<IShellItem> current;
+		dialog->GetFolder(&current);
+		VDStringW path = VDShellPath(current.Get());
+		mCurrentIndex = VDDiscFolderIndex(path);
+		mSelectedFolder.clear();
+		mSelectedIndex.clear();
+		UpdateDiscButton();
+		if (!mActivatedFolder.empty() && VDFileIsPathEqual(path.c_str(), mActivatedFolder.c_str()))
+			FinishFolder(mCurrentIndex);
+		mActivatedFolder.clear();
+		return S_OK;
+	}
+	IFACEMETHODIMP OnSelectionChange(IFileDialog *dialog) override {
+		Attach(dialog);
+		ComPtr<IShellItem> item;
+		SFGAOF attributes = 0;
+		bool folder = SUCCEEDED(dialog->GetCurrentSelection(&item)) &&
+			SUCCEEDED(item->GetAttributes(SFGAO_FOLDER, &attributes)) && (attributes & SFGAO_FOLDER);
+		VDStringW path = VDShellPath(item.Get());
+		mSelectedFolder = folder ? path : VDStringW();
+		mSelectedIndex = VDDiscFolderIndex(mSelectedFolder);
+		mNameAtSelection = mSelectedIndex.empty() ? VDStringW() : TypedName();
+		UpdateDiscButton();
+		UpdateFile(folder ? VDStringW() : path);
+		return S_OK;
+	}
+	IFACEMETHODIMP OnTypeChange(IFileDialog *dialog) override {
+		UINT index;
+		if (SUCCEEDED(dialog->GetFileTypeIndex(&index)) && index && index <= mState.xlat.size() &&
+			index != mState.nFilterIndex) {
+			mState.nFilterIndex = index;
+			if (!mState.filename.empty()) mState.ChangeFilename();
+		}
+		return S_OK;
+	}
+	IFACEMETHODIMP OnFileOk(IFileDialog *dialog) override {
+		ComPtr<IShellItem> result;
+		if (FAILED(dialog->GetResult(&result))) return S_FALSE;
+		VDStringW path = VDShellPath(result.Get());
+		if (path.empty()) return S_FALSE;
+		DWORD attr = GetFileAttributesW(path.c_str());
+		if (attr != INVALID_FILE_ATTRIBUTES && (attr & FILE_ATTRIBUTE_DIRECTORY)) {
+			FinishFolder(VDDiscFolderIndex(path));
+			return S_FALSE;
+		}
+		if (path.size() >= MAX_PATH) {
+			MessageBoxW(mState.mhdlg, g_VDEmbeddedRussian ? L"Путь к файлу слишком длинный." :
+				L"The file path is too long.", g_szError, MB_OK | MB_ICONERROR);
+			return S_FALSE;
+		}
+		UpdateFile(path);
+		return mState.FileOk() ? S_OK : S_FALSE;
+	}
+	IFACEMETHODIMP OnShareViolation(IFileDialog *, IShellItem *, FDE_SHAREVIOLATION_RESPONSE *response) override {
+		*response = FDESVR_DEFAULT;
+		return S_OK;
+	}
+	IFACEMETHODIMP OnOverwrite(IFileDialog *, IShellItem *, FDE_OVERWRITE_RESPONSE *response) override {
+		*response = FDEOR_DEFAULT;
+		return S_OK;
+	}
+	IFACEMETHODIMP OnItemSelected(IFileDialogCustomize *, DWORD id, DWORD item) override {
+		if (id == IDC_DRIVER && item && item <= mState.detectList.size())
+			mState.ForceUseDriver(item - 1);
+		if (id == IDC_OPEN_SINGLE) {
+			mState.select_mode = item == IDC_OPEN_SINGLE ? 0 : item == IDC_OPEN_SEGMENTS ? 1 : 2;
+			mState.ChangeSelection();
+		}
+		return S_OK;
+	}
+	IFACEMETHODIMP OnButtonClicked(IFileDialogCustomize *, DWORD id) override {
+		if (id == kChooseFolderPlaylist)
+			FinishFolder(mSelectedIndex.empty() ? mCurrentIndex : mSelectedIndex);
+		if (id == IDC_DRIVER_OPTIONS) mState.ChangeOptions();
+		if (id == IDC_DRIVER_INFO) mState.ShowFileInfo();
+		return S_OK;
+	}
+	IFACEMETHODIMP OnCheckButtonToggled(IFileDialogCustomize *, DWORD, BOOL) override { return S_OK; }
+	IFACEMETHODIMP OnControlActivating(IFileDialogCustomize *, DWORD) override { return S_OK; }
+
+private:
+	VDOpenVideoDialogW32& mState;
+	IFileDialog *mDialog = nullptr;  // Lives until after Unadvise.
+	VDStringW mLastTyped;
+	VDStringW mCurrentIndex, mSelectedFolder, mSelectedIndex, mNameAtSelection, mActivatedFolder;
+};
+
+VDStringW VDOpenExplorerVideoDialog(VDOpenVideoDialogW32& state, int key, const wchar_t *title,
+	const wchar_t *filters, const wchar_t *initialFile) {
+	VDCheckPicker(CoInitializeEx(nullptr, COINIT_APARTMENTTHREADED));
+	struct ComScope { ~ComScope() { CoUninitialize(); } } com;
+	ComPtr<IFileOpenDialog> dialog;
+	VDCheckPicker(CoCreateInstance(CLSID_FileOpenDialog, nullptr, CLSCTX_INPROC_SERVER, IID_PPV_ARGS(&dialog)));
+	FILEOPENDIALOGOPTIONS flags;
+	VDCheckPicker(dialog->GetOptions(&flags));
+	VDCheckPicker(dialog->SetOptions(flags | FOS_FORCEFILESYSTEM | FOS_PATHMUSTEXIST | FOS_FILEMUSTEXIST | FOS_NOCHANGEDIR));
+	VDCheckPicker(dialog->SetTitle(title));
+
+	std::vector<COMDLG_FILTERSPEC> types;
+	while (*filters) {
+		const wchar_t *pattern = filters + wcslen(filters) + 1;
+		types.push_back({filters, pattern});
+		filters = pattern + wcslen(pattern) + 1;
+	}
+	VDCheckPicker(dialog->SetFileTypes((UINT)types.size(), types.data()));
+	if (!state.nFilterIndex) state.nFilterIndex = 1;
+	VDCheckPicker(dialog->SetFileTypeIndex(state.nFilterIndex));
+
+	VDStringW initial = initialFile ? VDStringW(initialFile) : VDGetLastLoadSavePath(key);
+	DWORD attr = initial.empty() ? INVALID_FILE_ATTRIBUTES : GetFileAttributesW(initial.c_str());
+	if (!initial.empty()) {
+		bool directory = attr != INVALID_FILE_ATTRIBUTES && (attr & FILE_ATTRIBUTE_DIRECTORY);
+		VDStringW parent = directory ? initial : VDFileSplitPathLeft(initial);
+		ComPtr<IShellItem> folder;
+		if (SUCCEEDED(SHCreateItemFromParsingName(parent.c_str(), nullptr, IID_PPV_ARGS(&folder))))
+			dialog->SetFolder(folder.Get());
+		if (!directory && attr != INVALID_FILE_ATTRIBUTES)
+			dialog->SetFileName(VDFileSplitPath(initial.c_str()));
+	}
+
+	ComPtr<IFileDialogCustomize> controls;
+	VDCheckPicker(dialog.As(&controls));
+	const bool ru = g_VDEmbeddedRussian;
+	VDCheckPicker(controls->AddPushButton(kChooseFolderPlaylist, ru ? L"Выбрать плейлист…" : L"Choose playlist..."));
+	VDCheckPicker(controls->SetControlState(kChooseFolderPlaylist, CDCS_INACTIVE));
+	VDCheckPicker(controls->StartVisualGroup(4911, ru ? L"Модуль ввода" : L"Input driver"));
+	VDCheckPicker(controls->AddComboBox(IDC_DRIVER));
+	VDCheckPicker(controls->AddPushButton(IDC_DRIVER_OPTIONS, ru ? L"Настройки…" : L"Options..."));
+	VDCheckPicker(controls->AddPushButton(IDC_DRIVER_INFO, ru ? L"Сведения…" : L"File information..."));
+	VDCheckPicker(controls->AddText(IDC_INFO_MSG, L""));
+	VDCheckPicker(controls->EndVisualGroup());
+	VDCheckPicker(controls->StartVisualGroup(4913, ru ? L"Что открыть" : L"Open as"));
+	VDCheckPicker(controls->AddRadioButtonList(IDC_OPEN_SINGLE));
+	VDCheckPicker(controls->AddControlItem(IDC_OPEN_SINGLE, IDC_OPEN_SINGLE, ru ? L"Один файл" : L"Single file"));
+	VDCheckPicker(controls->AddControlItem(IDC_OPEN_SINGLE, IDC_OPEN_SEGMENTS, ru ? L"Связанные сегменты" : L"Linked segments"));
+	VDCheckPicker(controls->AddControlItem(IDC_OPEN_SINGLE, IDC_OPEN_SEQUENCE, ru ? L"Последовательность" : L"Sequence"));
+	VDCheckPicker(controls->SetSelectedControlItem(IDC_OPEN_SINGLE, IDC_OPEN_SEGMENTS));
+	VDCheckPicker(controls->EndVisualGroup());
+
+	auto events = Microsoft::WRL::Make<VDExplorerVideoEvents>(state);
+	if (!events) VDCheckPicker(E_OUTOFMEMORY);
+	state.custom = controls.Get();
+	if (attr != INVALID_FILE_ATTRIBUTES && !(attr & FILE_ATTRIBUTE_DIRECTORY))
+		events->UpdateFile(initial);
+	else {
+		state.EnableControl(IDC_DRIVER, false);
+		state.ChangeDriver();
+	}
+
+	DWORD cookie;
+	VDCheckPicker(dialog->Advise(events.Get(), &cookie));
+	HRESULT hr = dialog->Show(g_hWnd);
+	dialog->Unadvise(cookie);
+	events->Detach();
+	if (hr == HRESULT_FROM_WIN32(ERROR_CANCELLED)) {
+		if (events->ChosenDiscIndex.empty()) return VDStringW();
+	} else
+		VDCheckPicker(hr);
+	if (!events->ChosenDiscIndex.empty()) {
+		// Resolve the playlist while the current input and its playback position are intact.
+		using ChooseFolderPlaylist = int (__cdecl *)(HWND, const wchar_t *, wchar_t *, uint32);
+		auto choose = (ChooseFolderPlaylist)GetProcAddress(GetModuleHandleW(L"avlib-1.vdplugin"), "VDChooseFolderPlaylistW");
+		if (!choose)
+			throw MyError(g_VDEmbeddedRussian ? L"Не удалось загрузить модуль выбора плейлиста Blu-ray." :
+				L"Unable to load the Blu-ray playlist picker.");
+		wchar_t playlist[MAX_PATH] = {};
+		if (choose(g_hWnd, events->ChosenDiscIndex.c_str(), playlist, MAX_PATH) != 0)
+			return VDStringW();
+		state.filename = playlist;
+		// A disc selection always opens one MPLS using its detected decoder.
+		state.nFilterIndex = 1;
+		state.driver = nullptr;
+		state.driver_options.clear();
+		state.change_driver = false;
+		state.is_auto = true;
+		state.select_mode = 0;
+	}
+	VDSetLastLoadSaveFileName(key, state.filename.c_str());
+	return state.filename;
+}
